[portal]
DBusName=org.freedesktop.impl.portal.desktop.vasak-keyring
# Sólo el secreto maestro por aplicación. Lo sirve el llavero porque es quien
# tiene los secretos: el único backend que había con esta interfaz era el de
# KWallet, que los guardaba en una cartera de KDE que nada más del sistema lee.
Interfaces=org.freedesktop.impl.portal.Secret;
# `Vasak`, que es lo que la sesión exporta en XDG_CURRENT_DESKTOP. Esta clave es
# la red de seguridad; la forma que corresponde es `vasak-portals.conf`.
UseIn=Vasak;
