[Unit]
Description=VasakOS Secret Service keyring daemon
Documentation=https://github.com/Vasak-OS/vasak-keyring
Requires=dbus.socket
After=dbus.socket

[Service]
Type=simple
ExecStart=/usr/bin/vasak-keyring
Restart=on-failure
RestartSec=3

# Este proceso guarda **todas** las contraseñas de la sesión: es el backend del
# portal `Secret` y del servicio `org.freedesktop.secrets`. Hasta acá corría sin
# ninguna restricción, que para el proceso que menos conviene que se escape es
# justo al revés de lo que corresponde. Se le saca todo lo que no necesita para
# su trabajo, que es leer y escribir un archivo y atender D-Bus.
#
# La más importante de la lista es `RestrictAddressFamilies`: sin red, un fallo
# en este proceso no puede mandar los secretos a ninguna parte. Lo único que
# habla es sockets locales —D-Bus y el suyo de desbloqueo en /run/user—.
RestrictAddressFamilies=AF_UNIX

NoNewPrivileges=yes
# El llavero crea el archivo con los secretos. Sin esto nace legible por
# cualquier usuario de la máquina, que en un almacén de contraseñas es la
# diferencia entre estar cifrado y estar cifrado *y* fuera de la vista.
UMask=0077
# Y sus claves dejan de compartirse con el resto de los servicios del usuario:
# `KeyringMode=inherit`, el valor por omisión, deja el llavero del kernel de la
# sesión abierto a todos por igual.
KeyringMode=private

# Lo que **no** está, y por qué: `PrivateTmp`, `PrivateDevices`,
# `ProtectSystem`, `ProtectHostname`, `ProtectClock`, `ProtectControlGroups` y
# los tres `ProtectKernel*`. En una unidad de usuario, cualquiera de ellas hace
# que el gestor le cree al servicio un namespace de usuario propio, y desde
# adentro de ese namespace `/proc/<pid>/exe` de los procesos de la sesión da
# `EACCES`. Es la lectura con la que las dos puertas de este demonio saben
# quién les pide —el portal para `RetrieveSecret`, el sincronizador para la
# clave del almacén cifrado—, así que con ellas puestas no dejaban pasar a
# nadie, tampoco a los de verdad. Entre aislar al llavero y saber a quién le
# entrega un secreto, lo segundo es el trabajo del llavero.
#
# `ProtectProc=invisible` tampoco está: en una unidad de usuario no tiene
# efecto —se siguen viendo todos los procesos—, y si lo tuviera ocultaría
# justo los `/proc/<pid>` que las puertas necesitan leer.
#
# `CapabilityBoundingSet=` y `AmbientCapabilities=` tampoco: vaciar el conjunto
# límite es `prctl(PR_CAPBSET_DROP)` y tocar las ambientales también pide
# capacidades, y el gestor de systemd del usuario no tiene `CAP_SETPCAP`. En
# una unidad de usuario no restringen nada: el arranque se cae con
# `status=218/CAPABILITIES` («Failed to drop capabilities: Operation not
# permitted») y con él `org.freedesktop.secrets`. Tampoco agregaban nada: el
# proceso es de la sesión, sin setuid, nace con `CapEff` y `CapPrm` en cero y
# `NoNewPrivileges=yes` le impide ganar alguna después.
#
# Lo que sigue no crea namespaces y no toca esa lectura. Hay una prueba en
# `src/portal_secret.rs` que falla si alguna de las de arriba vuelve.
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# `@privileged` y `@resources` no le hacen falta: no cambia dueños, ni monta
# nada, ni toca prioridades.
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallFilter=~@resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=default.target
